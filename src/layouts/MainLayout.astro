---
import Footer from '../components/sections-layout/footer.astro'
import Navbar from '../components/sections-layout/navbar.astro'
import Layout from './Layout.astro'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title = 'joan rojas ✦ developer', description, image } = Astro.props
---

<Layout title={title} description={description} image={image}>
  <div
    class="min-h-screen relative overflow-x-clip before:absolute before:inset-0 before:z-[-100] before:bg-[url(/header-gradient.svg),url(/footer-gradient.svg)] before:bg-no-repeat before:bg-size-[1400px] before:bg-position-[center_top,center_bottom]"
  >
    <Navbar />
    <main class="relative w-full max-w-[708px] m-auto mt-8 px-4 sm:mt-14 sm:px-0">
      <slot />
      <Footer />
    </main>
  </div>
</Layout>
